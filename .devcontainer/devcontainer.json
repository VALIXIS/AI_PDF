{
  "name": "VALIXIS AI PDF Maker DevContainer",
  "image": "ghcr.io/cirruslabs/flutter:stable",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "/sdks/flutter",
        "editor.formatOnSave": true
      }
    }
  },
  "forwardPorts": [8085],
  "postCreateCommand": "flutter pub get"
}
